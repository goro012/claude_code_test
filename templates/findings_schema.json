{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractReviewFindings",
  "description": "子フロー「レビュー実行」が返す指摘一覧。段階1の指摘を全件含み、各指摘に段階2(雛形照合)の判定を付ける。Bot 表示用テキストは applies_to_template = false のものだけから生成する。",
  "type": "object",
  "required": ["findings", "summary"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "clause_ref", "category", "severity", "title", "detail", "suggestion",
          "applies_to_template", "template_clause_ref", "template_excerpt", "template_reason"
        ],
        "properties": {
          "clause_ref": {
            "type": "string",
            "description": "対象契約書の条項。例: 第12条、第5条第2項、該当条項なし"
          },
          "category": {
            "type": "string",
            "enum": [
              "損害賠償",
              "契約解除",
              "知的財産",
              "秘密保持",
              "準拠法・裁判管轄",
              "支払条件",
              "契約期間・更新",
              "反社条項",
              "再委託",
              "その他"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "title": {
            "type": "string",
            "description": "指摘の見出し。40 文字以内"
          },
          "detail": {
            "type": "string",
            "description": "何が問題か"
          },
          "suggestion": {
            "type": "string",
            "description": "修正提案。無ければ空文字"
          },
          "applies_to_template": {
            "type": "boolean",
            "description": "段階2の判定。true = 雛形契約書にも同じ内容が当てはまる(利用者には表示しない)。false = 当てはまらない(表示する)"
          },
          "template_clause_ref": {
            "type": "string",
            "description": "雛形契約書側の該当条項。無ければ「該当条項なし」"
          },
          "template_excerpt": {
            "type": "string",
            "description": "雛形契約書の該当箇所を原文のまま引用(200 字以内)。人判定カードに表示する。無ければ空文字"
          },
          "template_reason": {
            "type": "string",
            "description": "該当 / 非該当と判断した理由。1 文"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "全体所見。2〜3 文。表示対象(applies_to_template = false)の指摘に基づく"
    }
  }
}
